DATABASE_URL=postgresql://postgres:password@localhost:5432/circleup
# ── Local development workflow ─────────────────────────────────────────────────
# Start the local Postgres container and apply all migrations in one step:
#   npm run db:setup --workspace=indexer
#
# Reset the indexer database (wipe derived tables and restart from ledger 0):
#   npm run db:reset --workspace=indexer
#   This command refuses to run unless DATABASE_URL points at localhost or a
#   database whose name ends with _test or _dev. Rename your local database if
#   the check rejects it.
#
# Run the full test suite (offline + integration tests when DATABASE_URL is set):
#   npm test --workspace=indexer
#
# For integration tests that touch the database, use a dedicated test database:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/circleup_test \
#     npm test --workspace=indexer
#
# The db:reset and replay commands enforce the same local-database guard
# as the integration tests. Both will refuse to run if DATABASE_URL points
# at a remote host without a _test or _dev suffix in the database name.
# ── DB pool startup retry ──────────────────────────────────────────────────────
# How many times the indexer will retry the initial Postgres connection before
# aborting boot.  Uses exponential backoff starting at DB_CONNECT_BASE_DELAY_MS.
# Default 5 attempts produces delays of 1 s, 2 s, 4 s, 8 s (~15 s total wait).
# Maximum allowed value: 50.
DB_CONNECT_MAX_RETRIES=5
# Base delay in milliseconds for the first retry interval.  Each subsequent
# retry doubles this value.  Default 1000 ms.  Maximum allowed value: 60000 ms.
DB_CONNECT_BASE_DELAY_MS=1000
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# NOTE: The indexer reads events directly from the Soroban RPC and does not
# sign transactions, so NETWORK_PASSPHRASE is not required here. It is
# validated and used only by the app (NEXT_PUBLIC_NETWORK_PASSPHRASE) and the
# SDK (CircleUpConfig.networkPassphrase). Do not add it to REQUIRED_ENV_VARS.
CIRCLE_FACTORY_ADDRESS=
REPUTATION_ADDRESS=
USDC_ADDRESS=
PORT=3001
# Ledger to start indexing from (0 = genesis)
START_LEDGER=0
# How often to poll the RPC for new events, in milliseconds.
# Minimum 500 ms — lower values risk rate-limiting the Soroban RPC endpoint.
POLL_INTERVAL_MS=5000
# Max events fetched per getEvents() call (Soroban RPC caps this at 10000)
EVENTS_LIMIT=100

# ── Soroban RPC retry ──────────────────────────────────────────────────────────
# Maximum number of retry attempts for a single RPC call (getLatestLedger,
# getEvents) before the poll cycle is declared failed.  Default 4.  Max 20.
RPC_RETRY_MAX_ATTEMPTS=4
# Base delay in milliseconds for the first RPC retry interval.  Each subsequent
# retry doubles this with full jitter to spread load.  Default 500 ms.  Max 30000 ms.
RPC_RETRY_BASE_DELAY_MS=500

# ── Poll-cycle backoff ─────────────────────────────────────────────────────────
# When the entire poll cycle fails these three parameters control the
# exponential backoff between retries.
# Initial backoff interval in ms before the first retry.  Default 1000 ms.
# Range [100, 60000] ms.
POLL_BACKOFF_INITIAL_MS=1000
# Maximum interval the poll-cycle backoff will grow to.  Default 60000 ms.
# Max 300000 ms (5 min).
POLL_BACKOFF_MAX_MS=60000
# Exponential growth factor per failure.  Must be a finite number > 1.
# Default 2.0 (interval doubles each consecutive failure).
POLL_BACKOFF_MULTIPLIER=2.0
# Comma-separated allow-list for CORS (e.g. https://app.circleup.xyz,https://staging.circleup.xyz)
# Each entry must be a bare http(s) origin — no path/query. If unset (or every
# entry is invalid), all origins are allowed in development; with
# NODE_ENV=production this is a startup error instead of a silent wide-open CORS policy.
ALLOWED_ORIGINS=
# Number of reverse-proxy hops between the client and this process (used for
# rate-limit client identity). 0 = trust nothing, use the direct socket
# address. Set to 1 behind a single load balancer/reverse proxy.
TRUST_PROXY_HOPS=0
# Per-IP rate limits, one bucket per route class (list/detail/history share
# RATE_LIMIT_WINDOW_MS; health has its own generous cap so uptime monitors
# are never throttled by load on the other classes).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LIST_MAX=30
RATE_LIMIT_DETAIL_MAX=100
RATE_LIMIT_HISTORY_MAX=30
RATE_LIMIT_HEALTH_MAX=300

# ── Operational health (GET /health) ──────────────────────────────────────────
# Ledgers the indexer may fall behind the chain tip before /health reports
# "degraded". Default 1000 ≈ ~83 minutes at 5 s/ledger. Tune down for tighter
# alerting (e.g. 200 ≈ 16 min) or up for environments running deliberate
# re-index passes.
INDEXER_LAG_ALERT_LEDGERS=1000
# Maximum round difference between DB current_round and on-chain state before
# the contract drift check transitions to "degraded". Default 1.
DRIFT_ROUND_THRESHOLD=1
# Timeout in milliseconds for each individual health check component.
# Default 5000 ms.
HEALTH_TIMEOUT_MS=5000
