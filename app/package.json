{
  "name": "@circleup/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "npm run build --workspace=sdk",
    "build": "next build",
    "prebuild": "npm run build --workspace=sdk",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "license:check": "license-checker --production --excludePrivatePackages --out licenses-app.csv --csv",
    "license:summary": "license-checker --production --excludePrivatePackages --summary"
  },
  "dependencies": {
    "@circleup/sdk": "^0.1.0",
    "@stellar/stellar-sdk": "^12.3.0",
    "@stellar/freighter-api": "^2.0.0",
    "next": "14.2.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.395.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.0",
    "autoprefixer": "^10.4.19",
    "axe-core": "^4.9.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "jsdom": "^24.1.1",
    "license-checker": "^25.0.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vitest": "^2.1.0"
  }
}
