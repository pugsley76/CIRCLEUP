{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  // Test files live both in src/__tests__ and next to their module
  // (src/*.test.ts); neither belongs in dist/ or its declarations.
  "exclude": ["node_modules", "dist", "src/__tests__", "src/**/*.test.ts"]
}
